---
import { icons, type IconName } from '../icons';

/**
 * Umschalter (Tabs). Verhalten: scripts/tabs.ts, Styles: styles/components/umschalter.css.
 * `headline`: steckt in einer Überschrift und erbt deren Typo (<span>, Tabs nach Inhalt mit gleichem Padding).
 * `bar`: eigenständige Leiste unter einer Überschrift (<div>, Icon und Label, Breite nach Inhalt).
 * Die Panels baut die Sektion selbst: id `panel-{id}`, aria-labelledby `tab-{id}`. IDs müssen auf der Seite eindeutig sein.
 */
interface Props {
  tabs: { id: string; label: string; icon?: IconName }[];
  label: string;
  variant?: 'headline' | 'bar';
}

const { tabs, label, variant = 'headline' } = Astro.props;
const Tag = variant === 'headline' ? 'span' : 'div';
---

<Tag class:list={['umschalter', `umschalter--${variant}`]} role="tablist" aria-label={label}>
  <span class="umschalter__marker" data-marker aria-hidden="true"></span>
  {
    tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        class="umschalter__tab"
        id={`tab-${t.id}`}
        aria-controls={`panel-${t.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        {t.icon && <span class="umschalter__icon" aria-hidden="true" set:html={icons[t.icon]} />}
        {t.label}
      </button>
    ))
  }
</Tag>
