---
import { areas, artGroups, artenLead } from '../data/areas';
import AreaCard from './AreaCard.astro';
import Umschalter from './Umschalter.astro';

const chevronLeft = 'M14.5 6L8.5 12L14.5 18';
const chevronRight = 'M9.5 6L15.5 12L9.5 18';

/**
 * Sektion "Welche Natur wollt ihr heute entdecken?" mit Umschalter Gebiete | Arten in der Headline.
 * Umschalter: components/Umschalter.astro, Logik in scripts/tabs.ts (Karten-Besonderheiten in scripts/entdecken.ts).
 * Jedes Panel hat seinen eigenen Slider. Karten tragen data-reveal für die Einblend-Animation.
 */
const panels = [
  {
    id: 'gebiete',
    label: 'Gebiete',
    lead: 'Von der Küste bis zum Moor: Kalia sammelt Wege, die sich mit Kindern lohnen.',
    items: areas,
  },
  { id: 'arten', label: 'Arten', lead: artenLead, items: artGroups },
];
---

<section class="section entdecken" id="gebiete" aria-labelledby="areas-title" data-entdecken>
  <div class="container">
    <header class="section__head section__head--center entdecken__head">
      <h2 class="section__title entdecken__title" id="areas-title" aria-label="Welche Natur wollt ihr heute entdecken?">
        <span>Welche</span>
        <Umschalter tabs={panels} label="Ansicht wählen" variant="headline" />
        <span class="entdecken__rest">wollt ihr heute entdecken?</span>
      </h2>
    </header>

    {
      panels.map((p, i) => (
        <div role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} data-panel hidden={i !== 0}>
          <p class="section__lead entdecken__lead" data-lead>{p.lead}</p>
          <div class="areas-slider" data-areas-slider>
            <div
              class="areas-slider__viewport"
              data-slider-viewport
              role="group"
              aria-roledescription="Karussell"
              aria-label={p.label}
            >
              <ul class="areas" role="list" id={`karten-${p.id}`}>
                {p.items.map((a) => <AreaCard area={a} />)}
              </ul>
            </div>
            <div class="areas-slider__nav" data-slider-nav hidden>
              <button class="slider-button" type="button" data-slider-prev aria-label={`Vorherige ${p.label}`} aria-controls={`karten-${p.id}`}>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevronLeft} /></svg>
              </button>
              <button class="slider-button" type="button" data-slider-next aria-label={`Nächste ${p.label}`} aria-controls={`karten-${p.id}`}>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevronRight} /></svg>
              </button>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
