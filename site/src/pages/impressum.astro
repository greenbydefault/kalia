---
import Base from '../layouts/Base.astro';
---

<!-- Gerüst. Gelb markierte Lücken (.legal__gap) vor dem Livegang ersetzen und rechtlich prüfen lassen. -->
<Base title="Impressum – Kalia" description="Impressum von Kalia.">
  <div class="container container--narrow legal">
    <h1 class="legal__title">Impressum</h1>

    <h2>Angaben nach § 5 DDG</h2>
    <p><span class="legal__gap">[Lücke: Name des Rechtsträgers inkl. Rechtsform]</span></p>
    <p><span class="legal__gap">[Lücke: Straße, Hausnummer, PLZ, Ort]</span></p>
    <p><span class="legal__gap">[Lücke: Vertretungsberechtigte Person]</span></p>

    <h2 id="kontakt">Kontakt</h2>
    <p>E-Mail: <span class="legal__gap">[Lücke: E-Mail-Adresse]</span></p>

    <h2>Registereintrag und Umsatzsteuer</h2>
    <p>
      <span class="legal__gap">[Lücke: Registergericht und Registernummer, falls vorhanden]</span>
    </p>
    <p><span class="legal__gap">[Lücke: USt-IdNr., falls vorhanden]</span></p>

    <h2>Verantwortlich für den Inhalt</h2>
    <p><span class="legal__gap">[Lücke: Name und Anschrift nach § 18 Abs. 2 MStV]</span></p>
  </div>
</Base>
