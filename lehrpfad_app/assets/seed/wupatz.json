   "lat": 52.416039,
   "lon": 13.763513,
   "km": 2.5,
   "titel": "Spürnasentest",
   "thema": "Riechen wie ein Profi",
   "kurztext": "Duftstelen und Klapptafeln fordern die Nase: Welche Gerüche gehören zum Wald – und warum riecht ein Hund millionenfach besser als wir? Hier wird der Spürsinn zum Mitmachspiel.",
   "erlebnisse": [
    "tafel",
    "quiz"
   ],
   "barrierefrei": false,
   "steckbrief": null,
