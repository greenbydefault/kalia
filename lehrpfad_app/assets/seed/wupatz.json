   "lon": 13.7738016,
   "km": 1.77,
   "titel": "Balancierstrecke",
   "thema": "Gleichgewicht am Hubertussteg",
   "kurztext": "Am Hubertussteg über den Altarm der Löcknitz wird der Pfad zur Mitmachstrecke: Balancieren schärft Gleichgewicht und Konzentration – und führt durch urwäldlich anmutendes Ufergrün.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
