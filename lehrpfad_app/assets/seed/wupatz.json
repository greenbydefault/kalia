  },
  {
   "osmId": -3553968506,
   "lat": 52.416441,
   "lon": 13.768226,
   "km": 2.16,
   "titel": "Naturschutzgebiet Löcknitztal",
   "thema": "Schutz mit System",
   "kurztext": "Das Löcknitztal ist Schutzgebiet: Hier gelten Regeln, damit Wiese, Bruch und Fließ für seltene Arten erhalten bleiben. Die Station erklärt, warum Wege bleiben, wo sie sind – und was das für Pflanzen und Tiere bringt.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 12
  },
  {
   "osmId": 7837394572,
   "lat": 52.4160495,
   "lon": 13.7656677,
   "km": 2.34,
   "titel": "Landschaft und Waldharfe",
   "thema": "Hören und Schauen",
   "kurztext": "Zwischen Oberförsterei und Löcknitzinsel öffnet sich die Landschaft. An der Waldharfe wird Natur hörbar – Klang und Blick verbinden sich zu einer Pause mit allen Sinnen.",
   "erlebnisse": [
    "tafel",
    "audio"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 13
  },
  {
