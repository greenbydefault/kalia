  },
  {
   "osmId": -3899663678,
   "lat": 52.416508,
   "lon": 13.77061,
   "km": 2.0,
   "titel": "Leben in der Löcknitz",
   "thema": "Unter Wasser",
   "kurztext": "Was schwimmt und laicht im Fließ? Die Station blickt unter die Wasseroberfläche – vom Flussbarsch mit geteilter Rückenflosse bis zu den Pflanzen, die das Gewässer strukturieren.",
   "erlebnisse": [
