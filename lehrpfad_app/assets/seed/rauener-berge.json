  },
  {
   "osmId": 8887815747,
   "lat": 52.3194484,
   "lon": 14.0356004,
   "km": 2.61,
   "titel": "Nest der Roten Waldameise",
   "thema": "Die Baumpolizei des Waldes",
   "kurztext": "Der große Nadelhügel am Wegesrand ist ein Nest der Roten Waldameise. Die Ameisen erledigen im Wald Aufräumarbeiten und regulieren Schädlinge – die Tafel erklärt, wie so ein Staat aus Hunderttausenden Tieren funktioniert und warum er geschützt ist.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 4
  },
  {
   "osmId": 8887815750,
   "lat": 52.3193355,
   "lon": 14.0352,
   "km": 2.61,
   "titel": "Die Rauener Berge und die Markgrafensteine",
   "thema": "Eiszeit und Findlinge",
   "kurztext": "Die Rauener Berge sind eine Stauch- und Endmoräne der letzten Eiszeit. Mit dem Eis kamen riesige Findlinge aus dem Norden hierher – darunter die Markgrafensteine, die größten Findlinge Brandenburgs. Der Große Markgrafenstein wurde 1827 gespalten; aus seinem Mittelstück entstand die riesige Granitschale im Berliner Lustgarten. Die Steine sind als Nationales Geotop ausgewiesen und über einen kurzen Abstecher erreichbar.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 5
  },
  {
   "osmId": 8887815753,
   "lat": 52.3112467,
   "lon": 14.0362751,
   "km": 4.34,
   "titel": "Europäische Lärche",
   "thema": "Baumarten kennenlernen",
   "kurztext": "Die Europäische Lärche ist ein Nadelbaum, der im Winter seine Nadeln abwirft – und sich im Herbst goldgelb färbt. An dieser Station lernen wir, sie von Kiefer, Fichte und Co. zu unterscheiden.",
   "erlebnisse": [
    "tafel",
    "bestimmung"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 6
  },
  {
   "osmId": 8887815736,
   "lat": 52.3108826,
   "lon": 14.0360206,
   "km": 4.38,
   "titel": "Grubensee",
   "thema": "Wasser im Wald",
   "kurztext": "Der kleine Grubensee liegt still zwischen den Bäumen. An solchen Stillgewässern zeigt sich, wie vielfältig der Wald der Rauener Berge ist – von Libellen über Wasserpflanzen bis zu den Vögeln am Ufer.",
   "erlebnisse": [
    "tafel"
   ],
