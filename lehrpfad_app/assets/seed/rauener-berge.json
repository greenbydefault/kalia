  },
  {
   "osmId": 8244599364,
   "lat": 52.3101511,
   "lon": 14.0197198,
   "km": 0.0,
   "titel": "Bergbau Bahnhof",
   "thema": "Abtransport der Kohle",
   "kurztext": "An diesem Punkt endete einst der Transportweg der Braunkohle: Was in den Gruben der Rauener Berge gefördert wurde, ging von hier aus auf die weitere Reise. Die Tafel erzählt vom Zusammenspiel aus Bergbau und Bahn in der Region.",
   "erlebnisse": [
