  {
   "osmId": 2209900240,
   "lat": 52.310074,
   "lon": 14.0198405,
   "km": 0.0,
   "titel": "Bergbau in den Rauener Bergen",
   "thema": "Braunkohleabbau",
   "kurztext": "Mitten im Wald erinnert diese Tafel an eine andere Zeit: In den Rauener Bergen wurde früher Braunkohle abgebaut. Der ehemalige Stollenausgang der Braunkohleförderung liegt direkt am Weg – ein Relikt, das die Landschaft bis heute prägt.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
