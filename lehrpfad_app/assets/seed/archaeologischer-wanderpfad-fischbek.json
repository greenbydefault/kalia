  },
  {
   "osmId": 11800277726,
   "lat": 53.446505,
   "lon": 9.8568667,
   "km": 0.33,
   "titel": "Sinneswandel",
   "thema": "Langhügel, Bestattungsplatz der Bronzezeit",
   "kurztext": "Fünfzig Meter lang. Erst dachten die Ausgräber an ein steinzeitliches Hünenbett. Drin: neun bronzezeitliche Gräber, Körper und Brand. Am Ostende Steinsetzungen und Scherben, vermutlich zum Totenritual.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 2
  },
  {
   "osmId": 1737515240,
   "lat": 53.4439633,
   "lon": 9.858698,
   "km": 1.28,
   "titel": "Restbestände",
   "thema": "Doppelgrabhügel der Stein- und Bronzezeit",
   "kurztext": "Zwei Meter hoch, zwei Steinkreise ineinander. Unten Einzelgrabkultur, oben Bronzezeit. Eine Pfeilspitze aus Feuerstein, sonst fast leer. Sand frisst Holz, Leder, den Toten.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 3
  },
  {
   "osmId": 1737515237,
   "lat": 53.4439642,
   "lon": 9.8589647,
   "km": 1.28,
   "titel": "Aufhebenswertes",
   "thema": "Baumsargbestattung, hergezogen aus Lüllau",
   "kurztext": "Kein originaler Hügel von hier. Das Grab lag bei Lüllau, südwestlich von Jesteburg, und wäre dort verloren. Rekonstruiert: Baumsarg unter Steinkreis, später eine Urne in einer kleinen Steinkiste.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 4
  },
  {
   "osmId": 1737515244,
   "lat": 53.4441059,
   "lon": 9.8591943,
   "km": 1.3,
   "titel": "Grabesstille",
   "thema": "Bronzezeitlicher Grabhügel",
   "kurztext": "Noch ein Hügel der Bronzezeit in der Gruppe am Stadtweg. Weniger Spektakel als die Rekonstruktionen daneben, dafür der Originalbefund, so weit er steht.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 5
  },
  {
   "osmId": 1737515245,
   "lat": 53.4443409,
   "lon": 9.859163,
   "km": 1.33,
   "titel": "Spurensuche",
   "thema": "Rekonstruierter Doppelgrabhügel",
   "kurztext": "Die Zentralbestattung war ausgeraubt. Ein sichelförmiger Anbau, später eine Urne der vorrömischen Eisenzeit. Die Pflasterung der Hügelkuppe haben die Ausgräber wiederhergestellt.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 6
  },
  {
   "osmId": 1737515246,
   "lat": 53.4416003,
   "lon": 9.8551452,
   "km": 1.94,
   "titel": "Fundgrube",
   "thema": "Lehm- und Mergelkuhlen des 18./19. Jahrhunderts",
   "kurztext": "Keine Urgeschichte. Bauern holten hier Lehm und Mergel. Die Gruben liegen zwischen den Gräbern und erklären, warum so viele Hügel Löcher haben.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 7
  },
  {
   "osmId": 1737515248,
   "lat": 53.4392448,
   "lon": 9.852951,
   "km": 2.25,
   "titel": "Wiederverwendung",
   "thema": "Großsteingrab der Jungsteinzeit",
   "kurztext": "Die Steinkammer ist seit dem 18. Jahrhundert weg, Steinschläger haben sie zerlegt. 140 zerschlagene Gefäße am Rand: Sachsen nutzten den 4000 Jahre älteren Bau noch im 8./9. Jahrhundert als Kultplatz.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 8
  },
  {
   "osmId": 1737515222,
   "lat": 53.4404309,
   "lon": 9.851129,
   "km": 2.62,
   "titel": "Blickfang",
   "thema": "Grabhügel der älteren Bronzezeit",
   "kurztext": "Ein Hügel, den du wirklich siehst. Ältere Bronzezeit, aufgeschüttet über einer Bestattung. Vergleich ihn mit Station 3 nebenan: derselbe Typ, einmal noch da, einmal weggegraben.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 9
  },
  {
   "osmId": 13011543293,
   "lat": 53.4409476,
   "lon": 9.8509622,
   "km": 2.68,
   "titel": "Goldgräberstimmung",
   "thema": "Zerstörter Grabhügel der älteren Bronzezeit",
   "kurztext": "Ein Hügel, den Steinsucher und Landwirtschaft fast plattgemacht haben. Die Tafel zeigt, was fehlt: Kammer, Beigaben, Form. Zerstörung ist hier der Befund, nicht nur ein Schaden.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 10
  },
  {
   "osmId": 1737515258,
   "lat": 53.4420972,
   "lon": 9.8525819,
   "km": 2.86,
   "titel": "Glaubensbekenntnis",
   "thema": "Urnenfriedhof der Bronze- und Eisenzeit",
   "kurztext": "Oberirdisch nichts. Unter dem Waldboden lag ein Urnenfriedhof, den Gustav Schwantes in den 1920ern grub. Asche in Ton, manchmal Schmuck, der im Scheiterhaufen verschmolz. Die jüngsten Urnen kamen kurz vor Christi Geburt in die Erde.",
   "erlebnisse": [
