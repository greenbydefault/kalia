 "stationen": [
  {
   "osmId": 4882164121,
   "lat": 51.8673815,
   "lon": 13.973351,
   "km": 3.37,
   "titel": "Großer Spreewaldhafen",
   "thema": "Start am Kahnhafen",
   "kurztext": "Am Großen Spreewaldhafen, dem bekanntesten Kahnhafen des Spreewalds, beginnt die Runde. Von hier stechen die Kahnfährleute ihre Gäste in die Fließlandschaft – und wir starten zu Fuß in Richtung Lehde.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 1
  },
  {
   "osmId": 5679599845,
   "lat": 51.8691896,
   "lon": 13.9805129,
   "km": 3.91,
   "titel": "Biosphärenreservat Spreewald",
   "thema": "Lebensraum Fließlandschaft",
   "kurztext": "Die Tafel des Biosphärenreservats erklärt die Landschaft, durch die wir gehen: die weit verzweigten Fließe, die traditionellen Wasserschlagwiesen, die regelmäßig überflutet werden, und die Reste eiszeitlicher Moore, die enorme Mengen Kohlenstoff speichern.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 2
  },
  {
   "osmId": 1396123638,
   "lat": 51.8689086,
   "lon": 13.9820097,
   "km": 3.97,
   "titel": "Sehenswertes um Lehde",
   "thema": "Überblick über das Spreewalddorf",
   "kurztext": "Die Wanderkarte zeigt Lehde und seine Umgebung: das „Grüne Venedig“ besteht aus so vielen Inseln, wie es Häuser hat – die Fließe zwischen den Gehöften übernehmen weitgehend die Funktion von Straßen. Die gesamte Dorfanlage steht unter Denkmalschutz.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 3
  },
  {
   "osmId": 748503040,
   "lat": 51.8660418,
   "lon": 13.9910155,
   "km": 4.72,
   "titel": "Gurkenmuseum",
   "thema": "Die Spreewaldgurke",
   "kurztext": "Im Gurkenmuseum dreht sich alles um die berühmteste Frucht der Region: Vom Anbau auf den Feldern zwischen den Fließen über die Ernte mit dem Kahn bis zur Einlage in den Fässern. Die Spreewaldgurke ist heute eine geschützte Herkunftsbezeichnung.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 4
  },
  {
   "osmId": 5921188527,
   "lat": 51.8626556,
   "lon": 13.9909703,
   "km": 5.07,
   "titel": "Freilandmuseum Lehde",
   "thema": "Leben im Spreewald um 1900",
   "kurztext": "Das Freilandmuseum Lehde zeigt mit seinen historischen Gehöften, wie die sorbisch/wendischen und deutschen Spreewaldbewohner früher lebten und arbeiteten. Die Tafel beschreibt die einzelnen Stationen des Museums – ein lohnender Abstecher direkt am Weg.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 5
  },
  {
   "osmId": 8978006356,
   "lat": 51.86922,
   "lon": 13.968538,
   "km": 7.42,
   "titel": "Haus für Mensch und Natur",
   "thema": "Das Biosphärenreservat verstehen",
   "kurztext": "Das Haus für Mensch und Natur ist die Umweltbildungsstätte des Biosphärenreservats Spreewald. Hier erfahren wir, wie die einzigartige Kulturlandschaft aus Fließen, Wiesen und Wäldern entstanden ist und warum sie seit 1991 von der UNESCO als Biosphärenreservat geschützt wird.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 6
  },
  {
   "osmId": 1396044942,
   "lat": 51.8698059,
   "lon": 13.9706367,
   "km": 7.52,
   "titel": "Kahnfährmannsverein der Spreewaldfreunde",
   "thema": "Kahnfahrten durch den Spreewald",
   "kurztext": "Der Spreewaldkahn ist das traditionelle Fortbewegungsmittel zwischen den Fließen – früher wurden damit Heu, Gurken und sogar die Post transportiert. Der Kahnfährmannsverein hält die Kahnfahrt-Tradition in Lehde lebendig; von den Anlegestellen starten die Rundfahrten.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 7
  }
 ],
