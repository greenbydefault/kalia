 "stationen": [
  {
   "osmId": 2819118401,
   "lat": 51.8258637,
   "lon": 14.0509525,
   "km": 0.94,
   "titel": "Schorschkoa",
   "thema": "Was sind Moore?",
   "kurztext": "Moore sind Naturräume, die vom Wasser geprägt werden: Ein langanhaltender Überschuss hält den Boden permanent wassergesättigt, reicht aber nicht für einen See. Weil zersetzende Mikroorganismen unter Sauerstoffabschluss kaum arbeiten können, lagert sich organische Substanz als Torf an – nur etwa 1 mm pro Jahr. Wir erfahren außerdem, wie die Niedermoore des Spreewalds nach der letzten Eiszeit im Baruther Urstromtal entstanden und was die spreewaldtypische „Klockschicht“ damit zu tun hat.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": {
    "groesseHa": null,
    "alterJahre": 10000,
