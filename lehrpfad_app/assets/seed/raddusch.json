  {
   "osmId": 12749657756,
   "lat": 51.8342495,
   "lon": 14.0471221,
   "km": 2.62,
   "titel": "Rastplatz Buschmühle",
   "thema": "Rast an der historischen Mühle",
   "kurztext": "Der Rastplatz an der Buschmühle am Krummen Wehrfließ ist der erste Halt nach dem Naturhafen. Wer eine kürzere Runde gehen möchte, kann den Lehrpfad hier abkürzen. Gleich dahinter beginnt mit der „Stauabsenkung Süd“ das Naturschutzgebiet – rechts am Fließ ist die Steinschwelle zu sehen, mit der das Wasser angestaut wird.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 2
  },
  {
   "osmId": 12730609983,
   "lat": 51.8413125,
   "lon": 14.05578,
   "km": 3.6,
   "titel": "Dubkowmoor",
   "thema": "Bedeutung und Funktionen von Mooren",
   "kurztext": "Intakte Moore sind Klimaschützer, Wasserspeicher, Wasserfilter und Archive der Landschaftsgeschichte zugleich. Das Dubkowmoor ist mit einer Torfmächtigkeit von bis zu drei Metern besonders wertvoll: Naturnahe Niedermoore speichern je nach Typ rund 550 bis 2.000 Tonnen Kohlenstoff pro Hektar. Wird ein Moor entwässert, oxidiert der Torf und der Jahrtausende lang eingelagerte Kohlenstoff entweicht als CO2.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": {
    "groesseHa": null,
    "alterJahre": 10000,
    "tiefeM": 3.0,
    "lebenselixier": "mineralstoffreiches Grund- und Oberflächenwasser",
    "werdegang": "vom Überflutungsgebiet der Spree – zum torfbildenden Niedermoor"
   },
   "reihenfolge": 3
  },
  {
   "osmId": 5179763864,
   "lat": 51.848112,
   "lon": 14.0437414,
   "km": 4.84,
   "titel": "Hirschmoor",
   "thema": "Pflanzen und Tiere im Niedermoor",
   "kurztext": "Die Stauabsenkung Süd ist heute ein artenreiches Refugium: Rotbauchunke, Wollgras und das Sumpfblutauge – hier mit seinem größten zusammenhängenden Vorkommen im Spreewald – sind ebenso zu Hause wie Kiebitz, Bekassine, Kranich und der scheue Schwarzstorch. Im Auwald stehen Schwarzerlen, dazwischen sprossen Sumpfdotterblumen und Kalmus. Welche Arten entdecken wir auf dem Weg durch die Moorlandschaft?",
   "erlebnisse": [
    "tafel",
    "bestimmung"
   ],
   "barrierefrei": false,
   "steckbrief": {
    "groesseHa": null,
    "alterJahre": 10000,
    "tiefeM": null,
    "lebenselixier": "hohe Wasserstände durch Winterstau",
    "werdegang": "vom entwässerten Wiesenland – zum renaturierten Niedermoor-Refugium"
   },
   "reihenfolge": 4
  },
  {
   "osmId": 5179763862,
   "lat": 51.8476402,
   "lon": 14.008588,
   "km": 7.49,
   "titel": "Sauenmoor",
   "thema": "Eingriffe in den Wasserhaushalt",
   "kurztext": "Deiche, Umfluter und über 100 Stauanlagen haben den Spreewald im 20. Jahrhundert tiefgreifend verändert: Der Grundwasserspiegel fiel stellenweise um bis zu zwei Meter, Torfe zersetzten sich und der Boden sackte um bis zu 50 cm ab. Die rund 510 Hektar große „Stauabsenkung Süd“, in der wir hier stehen, wurde erst in den 1970er Jahren entwässert – ein Eingriff, der schon damals in der Bevölkerung heftig umstritten war.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": {
    "groesseHa": 510.0,
    "alterJahre": null,
    "tiefeM": null,
    "lebenselixier": "gesteuerte Wasserstände über Schöpfwerke und Wehre",
    "werdegang": "vom Niedermoor – zur Intensiv-Melioration – zur Wiedervernässung"
   },
   "reihenfolge": 5
  },
  {
   "osmId": 2819118201,
   "lat": 51.8431529,
   "lon": 14.0010231,
   "km": 9.09,
   "titel": "Schwarzer Weg",
   "thema": "Das Gewässerrandstreifenprojekt",
   "kurztext": "Von 2001 bis 2014 wurden hier die Wasserstände wieder erhöht und stabilisiert, um den Torfschwund zu stoppen: Im Winter werden weite Teile der Stauabsenkung geflutet, im Sommer nur dosiert Wasser eingelassen; eine Steinschwelle im Krummen Wehrfließ staut zusätzlich. Die Sommer-Wasserstände stiegen dadurch um bis zu 60 cm. Die Station zeigt auch, wie jeder selbst zum Moorschutz beitragen kann – etwa durch torffreie Blumenerde.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 6
  },
  {
   "osmId": 1288038156,
   "lat": 51.8357022,
   "lon": 14.008283,
   "km": 10.29,
   "titel": "Gustewitz",
   "thema": "Torfabbau im Spreewald",
   "kurztext": "„Am Torfstich“ – der Flurname erinnert an eine fast vergessene Arbeit: Seit dem frühen 19. Jahrhundert wurde hier Brenntorf von Hand gestochen, in Raddusch bis 1924; zu DDR-Zeiten folgten in den 1980er Jahren Mobilbagger für Düngetorf. Die Station beschreibt die mühsamen Arbeitsabläufe in den Handtorfstichen – vom „Abbanker“ bis zum „Stichler“. Mehr dazu in der Radduscher Heimatstube.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": {
    "groesseHa": null,
    "alterJahre": null,
    "tiefeM": null,
    "lebenselixier": null,
    "werdegang": "vom Handtorfstich des 19. Jahrhunderts – zum Mobilbagger-Abbau der DDR"
   },
   "reihenfolge": 7
  },
  {
   "osmId": 2819118301,
   "lat": 51.8255491,
   "lon": 14.0232024,
   "km": 11.96,
   "titel": "Quellgebiet Carna Gora",
   "thema": "Braunkohle und ihre Spätfolgen",
   "kurztext": "Die Tagebaue südwestlich von Raddusch ließen bis in die 1990er Jahre den Grundwasserspiegel absinken – Moore sackten um bis zu 60 cm ein, Häuser in Raddusch bekamen Schäden. Am Schwarzen Berg (niedersorbisch: Carna Gora) ist heute der Grundwasserwiederanstieg mit wieder aktiver Quelle zu sehen – und das Problem der Verockerung: Eisenocker färbt die Spreewässer braun und bedroht Fische, Schwarzstorch und Fischotter.",
   "erlebnisse": [
    "tafel"
   ],
