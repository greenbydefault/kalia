 "stationen": [
  {
   "osmId": 7999696432,
   "lat": 51.5029783,
   "lon": 11.8869486,
   "km": 0.07,
   "titel": "Heidebahnhof",
   "thema": "Halt der Halle-Hettstedter Eisenbahn",
   "kurztext": "Das alte Empfangsgebäude, nördlich vom Steig. 1896 ging die Bahn vom Klaustor über Nietleben und die Heide nach Lieskau. Heute halten hier die Busse 21 und 41. Gegenüber ein Parkplatz. Die Gaststätte im Haus ist zu. Der Pfad beginnt am Bergmannssteig, nicht an der Straße Waldkater.",
   "erlebnisse": [],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 1
  },
  {
   "osmId": 291778934,
   "lat": 51.5025724,
   "lon": 11.8861751,
   "km": 0.17,
   "titel": "Quarzporphyr",
   "thema": "Zwei Blöcke am Anfang des Bergmannssteigs",
   "kurztext": "Zwei Porphyrblöcke markieren den Steig. Der Obere Hallesche Porphyr ist lilarot und kleinkristallin, entstanden im Rotliegenden. Im Ostteil der Heide liegt er im Boden, hier im Westen kommt er nicht an die Oberfläche. Die Blöcke sind hingestellt. Bis Stein 32 läufst du auf Quarzsand, nur eine dünne Humusdecke darüber.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 2
  },
  {
   "osmId": 4460834455,
   "lat": 51.4992437,
   "lon": 11.8820509,
   "km": 0.63,
   "titel": "Waldkiefer",
   "thema": "Flügelkiefer, Stein 10",
   "kurztext": "Stein 10, links. Eine Waldkiefer, deren alte Borke in Platten vom Stamm absteht, wie kleine Flügel. Darunter nisten Baumläufer, im Mulm sitzen Käferlarven. Nadeln zu zweit, unten graue Tafelborke, oben fuchsrot. Seit der Mitte des 19. Jahrhunderts ist die Kiefer der Hauptbaum der Heide, über die Hälfte der Bestände.",
   "erlebnisse": [
    "bestimmung"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 3
  },
  {
   "osmId": 4460834456,
   "lat": 51.4991885,
   "lon": 11.8819193,
   "km": 0.63,
   "titel": "Mahonie",
   "thema": "Stein 11, immergrüner Strauch",
   "kurztext": "Stein 11, rechts, ein paar Schritte nach dem Flügelkiefer. Immergrün, Blätter lederig und glänzend, im Winter fast schwarz, im Frühjahr gelbe Trauben. Aus Nordamerika, hier verwildert. Um 1970 stand sie fast nur bei der Kolonie Waldheil. Westlich der Salzmünder Straße ist sie inzwischen durch die Heide gelaufen.",
   "erlebnisse": [
    "bestimmung"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 4
  },
  {
   "osmId": 272855029,
   "lat": 51.4915417,
   "lon": 11.8794596,
   "km": 1.72,
   "titel": "Waldheil",
   "thema": "Sommerkolonie von 1909",
   "kurztext": "Kreuzung Köllmer Weg und Bergmannssteig. 150 Meter nach Westen liegt die Siedlung Waldheil. 1909 hat der Juwelier Franz Tittel den Verein für Sommerhäuser gegründet. Nach dem Ersten Weltkrieg wurden die Lauben zu Wohnhäusern. Die Waldgaststätte gibt es nicht mehr. Der Pfad geht nicht in die Siedlung, er bleibt auf dem Steig.",
   "erlebnisse": [],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 5
  },
  {
   "osmId": 4460834480,
   "lat": 51.4875522,
   "lon": 11.8716639,
   "km": 2.56,
   "titel": "Lindbusch",
   "thema": "Naturschutzgebiet, Stein 32",
   "kurztext": "Stein 32, Blick ins NSG. Reichster Fleck der Heide, Eichen-Hainbuchenwald. Ton im Untergrund staut das Wasser, in den Senken stehen Eschen. Der Name kommt von Lint, Schlange, nicht von der Linde. Wege nicht verlassen, nichts mitnehmen. Bis hierher war der Boden Quarzsand. Ab hier eine schmale Tonzone zum Granauer Weg.",
   "erlebnisse": [],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 6
  },
  {
   "osmId": 10094911815,
   "lat": 51.4822943,
   "lon": 11.8910612,
   "km": 4.3,
   "titel": "Heidebad",
   "thema": "Bruchfeldsee in der Grube Neuglück",
   "kurztext": "Ende des Pfads, Haltestelle Am Heidebad. Im Tiefbau hat hier die Grube Neuglück Braunkohle geholt. Nach dem Einsturz der Stollen staute sich ab 1930 Wasser, 1954 ging das Bad auf. Westlich davon der kleine Heidesee, alte Sandgrube, Röhricht, Laichplatz der Erdkröte.",
   "erlebnisse": [],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 7
  }
 ],
