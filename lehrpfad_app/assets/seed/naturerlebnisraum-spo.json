  },
  {
   "osmId": -2314503982,
   "lat": 54.311366,
   "lon": 8.604773,
   "km": 0.27,
   "titel": "Mehr Salz als gesund ist",
   "thema": "Wie Pflanzen das Meer aushalten",
   "kurztext": "Queller speichert Salz bis er rot stirbt. Strandflieder drückt es über Drüsen raus. Andelgras sperrt es an der Wurzel. Fünf Tricks, ein Gift.",
   "erlebnisse": [
