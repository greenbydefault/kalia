   "lat": 54.312665,
   "lon": 8.60446,
   "km": 0.12,
   "titel": "Weltweit zu Hause",
   "thema": "Plattform Vogelzug",
   "kurztext": "Zehn Millionen Zugvögel nutzen das Watt als Tankstelle. Bei Flut rasten sie in der Bucht südlich von hier. Lautes Pfeifen? Oft der Austernfischer. Distanz halten, sie müssen fressen.",
   "erlebnisse": [
    "bestimmung"
   ],
   "barrierefrei": true,
   "steckbrief": null,
   "reihenfolge": 3
  },
  {
