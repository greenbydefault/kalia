  {
   "osmId": 4006047187,
   "lat": 47.8750638,
   "lon": 12.3538636,
   "km": 1.57,
   "titel": "Findlinge",
   "thema": "Ortsfremde Gesteine, Zeugen der Eiszeit",
   "kurztext": "Zwei Tafeln der Gemeinde bei der Strandanlage. Granit und Basalt im Chiemgau stammen aus dem Teil der Zentralalpen, aus dem das Eis des Inn-Gletschers kam. Deshalb heißen sie Findlinge oder erratische Blöcke. Daneben liegen Muschelkalk von Nussdorf, etwa 240 Millionen Jahre alt, und Korallenkalk.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 3
  },
  {
