  },
  {
   "osmId": 12839620095,
   "lat": 52.3507456,
   "lon": 13.0670702,
   "km": 3.75,
   "titel": "Wildbienen und Hummeln",
   "thema": "Bestäuber unter sich",
   "kurztext": "Neben der Honigbiene gibt es Hunderte Wildbienenarten – viele davon hochspezialisiert und bedroht. Die Tafel stellt Wildbienen und Hummeln vor und zeigt, woran man sie erkennt und was sie zum Blühen des Waldes brauchen.",
   "erlebnisse": [
    "tafel",
    "bestimmung"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 3
  },
  {
   "osmId": 12115220495,
   "lat": 52.3508197,
   "lon": 13.0666955,
   "km": 3.78,
   "titel": "Findlingspark",
   "thema": "Zeugen der Eiszeit",
   "kurztext": "Die Findlinge im Findlingspark wurden während der Eiszeiten von Gletschern aus Skandinavien bis hierher geschleppt. An den Steinen lernen wir, wie man Granit, Gneis und Co. unterscheidet – und was sie über die Eisströme von damals verraten.",
   "erlebnisse": [
    "tafel",
    "bestimmung"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 4
  },
  {
   "osmId": 12115220489,
   "lat": 52.3508886,
   "lon": 13.0667354,
   "km": 3.78,
   "titel": "Vielfältiges Leben im Reisighaufen",
   "thema": "Unterschlupf aus Ästen",
   "kurztext": "Was wie ein simpler Asthaufen aussieht, ist ein Miniatur-Biotop: Igel, Eidechsen, Kröten und unzählige Insekten finden im Reisighaufen Unterschlupf, Nahrung und Winterquartier. Die Tafel erklärt, warum solche Haufen im Wald bewusst liegen bleiben.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 5
  },
  {
   "osmId": 12829819614,
   "lat": 52.3509336,
   "lon": 13.0665601,
   "km": 3.78,
   "titel": "Alte und abgestorbene Bäume als Lebensraum",
   "thema": "Totholz steckt voller Leben",
   "kurztext": "Ein toter Baum ist alles andere als tot: Käfer, Pilze, Flechten, Fledermäuse und Höhlenbrüter wie Spechte nutzen Totholz als Nahrung, Brutplatz und Versteck. Warum alte und abgestorbene Bäume im Wald bleiben dürfen, erklärt diese Station.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 6
  },
  {
   "osmId": 12829819613,
   "lat": 52.3511584,
   "lon": 13.0665105,
   "km": 3.82,
   "titel": "Die Rote Waldameise",
   "thema": "Die Baumpolizei des Waldes",
   "kurztext": "Die Nadelhügel der Roten Waldameise beherbergen Staaten aus Hunderttausenden Tieren. Die Ameisen räumen den Wald auf und regulieren Schädlinge – die Tafel zeigt, wie so ein Ameisenstaat funktioniert und warum er unter Schutz steht.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 7
  },
  {
   "osmId": 12829816556,
   "lat": 52.3544188,
   "lon": 13.0615564,
   "km": 4.35,
   "titel": "Naturschutzgebiet Moosfenn",
   "thema": "Feuchtgebiet am Waldrand",
   "kurztext": "Das Naturschutzgebiet Moosfenn ist ein Feuchtgebiet mit Gräben, Röhrichten und feuchten Wiesen – ein Refugium für Libellen, Amphibien und Wasservögel. Die Tafel des Potsdamer Naturschutzes erklärt, warum das Gebiet besonders geschützt ist.",
