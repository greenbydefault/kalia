  {
   "osmId": 2994769706,
   "lat": 52.3530733,
   "lon": 13.0790728,
   "km": 1.77,
   "titel": "Engelsquelle",
   "thema": "Wasser im Wald",
   "kurztext": "An der Engelsquelle geht es um das nasse Element mitten im Wald: Quellen und feuchte Senken sind wertvolle Lebensräume für Amphibien, Insekten und Vögel – und empfindliche Stellen, die wir auf den Wegen besonders schonen.",
   "erlebnisse": [
