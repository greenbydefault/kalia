   "lon": 10.4238172,
   "km": 2.27,
   "titel": "Die Adler sind zurück",
   "thema": "Strandweg Höhe Bahnhof",
   "kurztext": "Tafel drei, Höhe Bahnhof. Seeadler über dem Großen Plöner See, nach Jahrzehnten wieder. Unten am Wasser sitzen die Stockenten. Zugvögel nutzen den See als Knoten.",
   "erlebnisse": [
    "tafel"
   ],
