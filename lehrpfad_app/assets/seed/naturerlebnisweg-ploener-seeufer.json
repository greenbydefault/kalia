   "lat": 54.1567002,
   "lon": 10.4171184,
   "km": 2.83,
   "titel": "Knotenpunkt des Vogelzugs",
   "thema": "Schlosspark, Aussicht auf den See",
   "kurztext": "Tafel acht, Schlosspark. Von hier siehst du den See als Straße für Vögel. Kormoran, Ente, im Winter die Tauchenten. Die Unterführung zum Schlossgebiet liegt daneben, der PlanetenPfad nicht dieser Weg.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 3
  },
  {
   "osmId": -1721269457,
   "lat": 54.1502993,
   "lon": 10.4073453,
   "km": 3.83,
   "titel": "Alte Buchen",
   "thema": "Schlosswald Höhe Siebenstern",
   "kurztext": "Tafel zehn im Schlosswald. Alte Buchen, glatte Rinde, wenig Unterwuchs. Daneben Erle am nassen Rand und Tafeln zu Fledermäusen und Baumhöhlen. Siebenstern ist der Wegname, nicht eine Stationstafel.",
   "erlebnisse": [
