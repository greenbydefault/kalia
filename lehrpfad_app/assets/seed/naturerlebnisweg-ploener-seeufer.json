   "lat": 54.1470961,
   "lon": 10.4084713,
   "km": 4.23,
   "titel": "Pflanzengemeinschaften des Seeufers",
   "thema": "Anfang Prinzeninsel, Tafel 14",
   "kurztext": "Hier beginnt die Insel. Schilf, Weide, was nasse Füße aushält. Die Tafel sortiert die Uferzonen, nicht den Schlossgarten. Brücke und Geschichte liegen ein Stück weiter.",
   "erlebnisse": [
    "tafel"
   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 5
  },
  {
   "osmId": 11111216339,
   "lat": 54.1469766,
   "lon": 10.4080737,
   "km": 4.25,
   "titel": "Geschichte der Prinzeninsel",
   "thema": "Brücke Prinzeninsel, Tafel 15",
   "kurztext": "Tafel an der Brücke. Prinzeninsel, Name aus dem 19. Jahrhundert, vorher eine Halbinsel mit Arbeit und Holz. Heute Weg und Tafeln, kein Schlosspark. Die Kesselfalle des Aronstabs steht im Wald dahinter.",
   "erlebnisse": [
