   ],
   "barrierefrei": false,
   "steckbrief": null,
   "reihenfolge": 6
  },
  {
   "osmId": 11111216336,
   "lat": 54.144599,
   "lon": 10.4057793,
   "km": 4.25,
   "titel": "Die Kesselfalle des Aronstabs",
   "thema": "Prinzeninsel Wald, Tafel 17",
   "kurztext": "Im Wald der Insel. Aronstab lockt Fliegen in die Kessel, lässt sie erst raus wenn der Pollen sitzt. Riecht nach Aas, sieht nach Blatt. Nicht anfassen, der Saft reizt.",
