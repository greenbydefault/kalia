<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Offline-Dateien weder in Cloud-Backup noch Geräte-Transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline/" />
    </device-transfer>
</data-extraction-rules>
